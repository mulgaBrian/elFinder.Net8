<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>Yevhen Noskov, Leniel Macaferi, Matt Gordon, Flavio Smirne, Trung Tran</Authors>
    <Company>N/A</Company>
    <Copyright></Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mulgaBrian/elFinder.Net8</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mulgaBrian/elFinder.Net8</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>elFinder, connector, file-manager, driver</PackageTags>
    <IsPackable>true</IsPackable>
    <Description>
      An elFinder backend connector with less magic code and more compatibility.
      This enables .NET 8 projects to easily integrate elFinder functionalities.
      See the example project on Github for usage detail.
    </Description>
    <PackageIcon>logo.png</PackageIcon>
    <Version>8.1.4</Version>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IncludeSymbols>True</IncludeSymbols>
    <PackageId>elfinder.Net8</PackageId>
    <Title>elfinder.Net8</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(OutputPath)..\..\Nuget</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ffmpeg\**" />
    <EmbeddedResource Remove="ffmpeg\**" />
    <None Remove="ffmpeg\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Helpers\FFmpegBinariesHelper.cs" />
  </ItemGroup>

	<ItemGroup>
    <PackageReference Include="FFmpeg.GPL" Version="[20251001.1.0]" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.StaticFiles" Version="2.3.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="10.0.14" />
    <PackageReference Include="MimeTypeMapOfficial" Version="1.0.17" />
    <PackageReference Include="ThumbGen" Version="0.4.1" />
    <PackageReference Include="ThumbGen.Magick" Version="0.4.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Assets\logo.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <Target Name="CopyPackageAfterReleaseBuild" AfterTargets="Pack" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <NewNuGetPackage Include="$(OutputPath)..\**\*.nupkg" />
    </ItemGroup>
    <Copy SourceFiles="@(NewNuGetPackage)" DestinationFolder="D:\Packages\" SkipUnchangedFiles="true" />
  </Target>
</Project>
